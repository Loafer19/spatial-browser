# cp .cargo/config.toml.example .cargo/config.toml and set CEF_PATH.
# Required at build time by cef-dll-sys.

[env]
CEF_PATH = { value = "/home/YOU/.local/share/cef", force = true }

# libcef.so next to the binary ($ORIGIN) for debug and target/bundle.
[target.x86_64-unknown-linux-gnu]
rustflags = ["-C", "link-args=-Wl,-rpath,$ORIGIN"]
